[Unit]
Description=Silk Nodes TX Price Collector (exchange tickers)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=__REPO_PATH__/vm-service
ExecStart=__NODE_PATH__ __REPO_PATH__/vm-service/collect-price.mjs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=silknodes-price
Environment=NODE_ENV=production
Environment=REPO_PATH=__REPO_PATH__
EnvironmentFile=-/home/%i/.silknodes-db.env
# Five parallel ticker reads with an 8s timeout each, plus one insert.
TimeoutStartSec=50s

[Install]
WantedBy=multi-user.target
