[Unit]
Description=Silk Nodes Governance Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=__REPO_PATH__/vm-service
ExecStart=__NODE_PATH__ __REPO_PATH__/vm-service/collect-governance.mjs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=silknodes-governance
Environment=NODE_ENV=production
Environment=REPO_PATH=__REPO_PATH__
Environment=LOG_LEVEL=info
EnvironmentFile=-/home/%i/.silknodes-db.env
# A full pass is ~2s with one live proposal. 5 min is a wide margin for a
# slow node or an unusually busy vote, and short enough that a hung run
# cannot block the next tick.
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
