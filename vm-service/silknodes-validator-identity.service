[Unit]
Description=Silk Nodes Validator Identity Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=__REPO_PATH__/vm-service
ExecStart=__NODE_PATH__ __REPO_PATH__/vm-service/collect-validator-identity.mjs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=silknodes-validator-identity
Environment=NODE_ENV=production
Environment=REPO_PATH=__REPO_PATH__
Environment=LOG_LEVEL=info
EnvironmentFile=-/home/%i/.silknodes-db.env
# ~14s for 106 validators, most of it Keybase. 10 min is a wide margin for
# Keybase being slow without letting a hung run sit forever.
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
