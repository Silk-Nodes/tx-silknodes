[Unit]
Description=Silk Nodes Stablecoin Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=__REPO_PATH__/vm-service
ExecStart=__NODE_PATH__ __REPO_PATH__/vm-service/collect-stablecoins.mjs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=silknodes-stablecoins
Environment=NODE_ENV=production
Environment=REPO_PATH=__REPO_PATH__
Environment=LOG_LEVEL=info
EnvironmentFile=-/home/%i/.silknodes-db.env
# A snapshot run is ~2s. The first transfer fill after migration 022 walks
# 30 days of the tx index, a few dozen calls on a slow node.
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
