# Coreum RPC/LCD Endpoints (Silk Nodes)
NEXT_PUBLIC_COREUM_RPC=https://full-node.mainnet-1.coreum.dev:26657
NEXT_PUBLIC_COREUM_LCD=https://full-node.mainnet-1.coreum.dev:1317
NEXT_PUBLIC_SILK_RPC=https://coreum-rpc.silknodes.io
NEXT_PUBLIC_SILK_LCD=https://coreum-lcd.silknodes.io

# CoinGecko
NEXT_PUBLIC_COINGECKO_API=https://api.coingecko.com/api/v3

# Chain Config
NEXT_PUBLIC_CHAIN_ID=coreum-mainnet-1
NEXT_PUBLIC_DENOM=ucore
NEXT_PUBLIC_COIN_DENOM=COREUM
NEXT_PUBLIC_DISPLAY_DENOM=CORE
NEXT_PUBLIC_COIN_DECIMALS=6

# Silk Nodes Validator
NEXT_PUBLIC_VALIDATOR_ADDRESS=corevaloper1...

# ─── DB connection (Phase 2: API routes read from Postgres) ─────────────
# Same env vars the VM collectors use, so on the VM you can simply:
#   set -a; source ~/.silknodes-db.env; set +a
#   npm start
# Locally (dev) you can point at a local Postgres OR tunnel the VM's DB:
#   ssh -L 5432:localhost:5432 zoltan@<vm-ip>
PGHOST=localhost
PGPORT=5432
PGUSER=silknodes
PGPASSWORD=REPLACE_ME
PGDATABASE=tx_silknodes
# Optional: DB_LOG=true to log every SQL statement Sequelize runs
# DB_LOG=false

# Local dev only: proxy the DB-backed flows/analytics API routes to a live
# deployment so those pages render real data without a Postgres connection.
# Leave unset in production. Example:
# DEV_API_PROXY=https://tx.silknodes.io

# ── Public API access ────────────────────────────────────────────────
# Keys issued to external consumers, as label:secret pairs:
#   API_KEYS=mart:8f3c...,partner:19ab...
#
# The label is what gets logged and revoked, so one abusive integrator can be
# cut off by editing this line without affecting anyone else.
#
# Our own frontend does NOT use these. It is client-rendered, so a key shipped
# in the JS bundle would be readable in devtools: that would look like access
# control while providing none. Browser requests are recognised by
# Sec-Fetch-Site instead. This is friction and attribution, not a
# confidentiality boundary.
#
# Leave EMPTY to keep the API fully open. Enforcement only switches on once at
# least one key exists, so a blank value cannot lock everyone out on deploy.
API_KEYS=

# Gates the detailed table counts on /api/health. Without it the endpoint is a
# plain liveness probe, which is all it owes the public.
HEALTH_TOKEN=
